# ─────────────────────────────────────────────────────────────
# Annumovies — Environment Variables
# Copy this file to .env and fill in your values
# On Vercel: add these in Project Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# TMDB API Read Access Token (get from https://www.themoviedb.org/settings/api)
TMDB_TOKEN=your_tmdb_bearer_token_here

# Frontend URL (set to your Vercel deployment URL in production)
# Example: https://annumovies.vercel.app
VITE_BACKEND_URL=
